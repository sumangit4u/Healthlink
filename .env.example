# HealthLink Environment Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# Only the two API keys are strictly required; everything else has a sane default.

# ===========================================
# REQUIRED API KEYS
# ===========================================

# Gemini API Key (REQUIRED) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone API Key (REQUIRED for RAG) - https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# ===========================================
# LLM CONFIGURATION (optional overrides)
# ===========================================
LLM_MODEL_NAME=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL_NAME=models/gemini-embedding-001

# ===========================================
# PINECONE / RAG CONFIGURATION
# ===========================================
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=healthlink
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===========================================
# DATABASE
# ===========================================
# Local development (zero setup):
DATABASE_URL=sqlite:///./data/healthlink.db
# Production (managed Postgres). Uncomment and point at your instance:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/healthlink
DB_ECHO=False
# Connection pool (used only for non-SQLite databases)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# ===========================================
# API / SERVER
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
# Keep reload OFF in any shared/production environment:
API_RELOAD=False
# Number of Gunicorn workers per instance (also settable via Dockerfile/platform):
WEB_CONCURRENCY=2
# JSON array of allowed origins for CORS:
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# ===========================================
# LOGGING / OBSERVABILITY
# ===========================================
LOG_LEVEL=INFO
ENABLE_METRICS=True
# Optional LangSmith tracing for prompt/agent observability:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=healthlink

# ===========================================
# SECURITY
# ===========================================
# CHANGE THIS in production (use a long random value / secret manager):
SECRET_KEY=dev-secret-key-change-in-production

# ===========================================
# AZURE DEPLOYMENT (used by deploy.ps1 / deploy.sh)
# ===========================================
# These are set inside the deploy scripts, not required at app runtime. Listed
# here for reference only. The deploy scripts create everything in ONE resource
# group and read GEMINI_API_KEY / PINECONE_API_KEY from the shared .env above.
# RESOURCE_GROUP=healthlink-rg
# LOCATION=centralindia
# ACR_NAME=healthlinkacr<random>   # printed by the deploy script

# ===========================================
# OPTIONAL CACHE (see README scaling notes)
# ===========================================
# REDIS_URL=redis://localhost:6379/0
